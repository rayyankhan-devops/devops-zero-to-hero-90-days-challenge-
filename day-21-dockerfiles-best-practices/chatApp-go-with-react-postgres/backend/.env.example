# Go Backend Environment Variables Example
PORT=8080

# PostgreSQL Configuration
# For local dev without Docker, DB_HOST is usually 'localhost' or '127.0.0.1'
# For Docker Compose execution, DB_HOST is set to 'db' (the service name in docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=chatapp
