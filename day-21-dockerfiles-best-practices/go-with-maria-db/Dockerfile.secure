# ==============================================================================
# STAGE 1: Ultra-Hardened Builder Stage (Latest Patched Go Compiler)
# ==============================================================================
FROM golang:alpine AS builder

# Install CA certificates and timezone data
RUN apk --no-cache add ca-certificates tzdata

WORKDIR /usr/src/app

# Copy dependency files first for optimal layer caching
COPY backend/go.mod backend/go.sum ./
RUN go mod download

# Copy backend source code & frontend static assets
COPY backend/ ./
COPY public/ ../public/

# Build static, stripped, hardened Go binary:
# - CGO_ENABLED=0: Fully static binary (no C library dependencies)
# - -trimpath: Removes local filesystem paths from binary metadata
# - -ldflags="-w -s": Strips debugging symbols (~35% reduction in size)
RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-w -s" \
    -o /server main.go

# Generate unprivileged non-root user entry for scratch (UID/GID 65532)
RUN echo "gouser:x:65532:65532:Non-Root User:/app:/sbin/nologin" > /etc/passwd-gouser && \
    echo "gouser:x:65532:" > /etc/group-gouser


# ==============================================================================
# STAGE 2: Zero-Vulnerability Minimal Runtime Stage (Scratch - 2.9MB)
# ==============================================================================
FROM scratch

# Copy root CA certificates for HTTPS/SSL support
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Copy unprivileged non-root user/group definitions
COPY --from=builder /etc/passwd-gouser /etc/passwd
COPY --from=builder /etc/group-gouser /etc/group

WORKDIR /app

# Copy stripped Go binary & static frontend assets with non-root ownership
COPY --from=builder --chown=65532:65532 /server ./server
COPY --from=builder --chown=65532:65532 /usr/src/public ../public

# Enforce Non-Root User Execution (UID 65532)
USER 65532:65532

EXPOSE 8080

CMD ["./server"]
