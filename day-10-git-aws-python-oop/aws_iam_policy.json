{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3ReadAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::rayyan-devops-backups",
        "arn:aws:s3:::rayyan-devops-backups/*"
      ]
    },
    {
      "Sid": "AllowEC2ReadAccess",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeStatus"
      ],
      "Resource": "*"
    }
  ]
}
